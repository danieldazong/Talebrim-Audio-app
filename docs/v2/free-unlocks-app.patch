+import { useAuth } from "@clerk/expo";
+import { useQuery, useQueryClient } from "@tanstack/react-query";
+import { useCallback, useEffect, useRef, useState } from "react";
+
+import { useEntitlement } from "@/hooks/use-entitlement";
+import { useIsOnline } from "@/hooks/use-downloads";
+import { useIsForeground } from "@/hooks/use-is-foreground";
+import type { PaywallChapter } from "@/hooks/use-paywall-chapter";
+import { track } from "@/lib/analytics";
+import { entitlementOptions } from "@/lib/queries/billing";
+import { chapterDetailOptions } from "@/lib/queries/chapters";
+import { claimWaitUnlock, unlocksByUserOptions, waitUnlockStatusOptions } from "@/lib/queries/unlocks";
+import { syncServerPlan } from "@/lib/server-plan";
+import {
+  UNLOCK_FAILED,
+  claimFailureKind,
+  countdownAt,
+  parseWaitClaim,
+  subscribedLine,
+  waitButtonView,
+  waitOption,
+  type UnlockFailureKind,
+  type WaitClaim,
+  type WaitStatus,
+} from "@/lib/unlock";
+
+/** How many times the read-back of a just-claimed unlock is tried: the unlock is permanent, so it is worth a retry or two. */
+const READ_BACK_RETRIES = 2;
+
+/**
+ * M5a's `Unlock free` — prompt 23, Part A. The free unlock: one chapter per
+ * story every 24 hours, claimed from the server (`claim_wait_unlock()`), which
+ * keeps the clock and writes the unlock. This hook never opens a chapter and
+ * never writes anything: it asks, shows what the server answered, and
+ * refetches the reader's unlocks. M5a's own effect opens the chapter once
+ * `usePaywallChapter()` says it is `open`, which only a row read back (or a
+ * plan) can make it.
+ *
+ * `chapter` is the locked chapter M5a is showing, or null: for an open chapter
+ * the hook does nothing, so neither free option is ever offered for one.
+ *
+ * The countdown is the server's seconds less the time since they landed, on the
+ * monotonic clock (`lib/unlock.ts`), redrawn once a minute. It is asked for
+ * again when it reaches 0 and whenever the app returns to the foreground:
+ * Android's monotonic clock may not tick while the phone sleeps, so a count
+ * is never carried across a background.
+ */
+export function useUnlockOptions(chapter: PaywallChapter | null) {
+  const { userId } = useAuth();
+  const queryClient = useQueryClient();
+  const entitlement = useEntitlement();
+  const online = useIsOnline();
+  const foreground = useIsForeground();
+
+  const chapterId = chapter?.id ?? null;
+  const bookId = chapter?.bookId ?? null;
+  const locked = chapterId !== null;
+
+  const statusQuery = useQuery({
+    ...waitUnlockStatusOptions(userId ?? "", bookId ?? ""),
+    enabled: Boolean(userId) && locked,
+  });
+  const { data, refetch: refetchStatus } = statusQuery;
+
+  // --- The countdown ---------------------------------------------------------
+  // `now` moves only when a timer says the words will change, so the sheet
+  // redraws once a minute. The words and the timer both come from
+  // `countdownAt()` with this same `now`: a timer read from a fresher clock
+  // than the words left a label up for a whole minute (2026-10-03).
+  const [now, setNow] = useState(() => performance.now());
+  useEffect(() => {
+    if (data === undefined || data.seconds === 0) return;
+    const { redrawInMs } = countdownAt(data.seconds, data.receivedAt, now);
+    if (redrawInMs === null) {
+      // Over by our count: the server decides whether it really is.
+      void refetchStatus();
+      return;
+    }
+    const timer = setTimeout(() => setNow(performance.now()), redrawInMs);
+    return () => clearTimeout(timer);
+  }, [data, now, refetchStatus]);
+
+  // Back from the background: ask again, never carry the count over it.
+  const wasForeground = useRef(foreground);
+  useEffect(() => {
+    if (foreground && !wasForeground.current && locked && Boolean(userId)) void refetchStatus();
+    wasForeground.current = foreground;
+  }, [foreground, locked, userId, refetchStatus]);
+
+  const secondsLeft = data === undefined ? null : countdownAt(data.seconds, data.receivedAt, now).left;
+  const status: WaitStatus =
+    secondsLeft !== null ? { state: "ready", secondsLeft } : statusQuery.isError ? { state: "failed" } : { state: "loading" };
+  const option = waitOption({ locked, subscribed: entitlement.data?.active === true, online, status });
+  const countdown = option.kind === "cooldown" ? option.secondsLeft : null;
+
+  // --- Analytics, once per open ----------------------------------------------
+  const offered = useRef(false);
+  useEffect(() => {
+    if (offered.current || chapterId === null || bookId === null || data === undefined) return;
+    offered.current = true;
+    // `wait`: available to take. `ad`: Part B's rewarded ad, not built.
+    track("unlock_offered", { book_id: bookId, chapter_id: chapterId, wait: data.seconds === 0, ad: false });
+  }, [chapterId, bookId, data]);
+
+  const countdownShown = useRef(false);
+  useEffect(() => {
+    if (countdownShown.current || chapterId === null || bookId === null || countdown === null) return;
+    countdownShown.current = true;
+    track("wait_unlock_unavailable", { book_id: bookId, chapter_id: chapterId, seconds_left: Math.round(countdown) });
+  }, [chapterId, bookId, countdown]);
+
+  // --- The claim ---------------------------------------------------------------
+  const [claiming, setClaiming] = useState(false);
+  const [claimLine, setClaimLine] = useState<string | null>(null);
+  const busy = useRef(false);
+  const mounted = useRef(true);
+  useEffect(() => {
+    mounted.current = true;
+    return () => {
+      mounted.current = false;
+    };
+  }, []);
+  // A claim whose unlock is waiting to be read back, so `opened()` can say how long it took.
+  const pending = useRef<{ bookId: string; chapterId: string; startedAt: number } | null>(null);
+
+  const claim = useCallback(async () => {
+    if (chapterId === null || bookId === null || !userId || busy.current) return;
+    busy.current = true;
+    setClaiming(true);
+    setClaimLine(null);
+    const ids = { book_id: bookId, chapter_id: chapterId };
+    const startedAt = performance.now();
+    // The one line a failed claim leaves, and whether the spinner stays: it
+    // stays only while the chapter is about to open.
+    let line: string | null = null;
+    let keepSpinning = false;
+
+    const readBack = () => queryClient.fetchQuery({ ...unlocksByUserOptions(userId), staleTime: 0, retry: READ_BACK_RETRIES });
+    const failed = (kind: UnlockFailureKind) => {
+      track("unlock_record_failed", { ...ids, source: "wait", kind });
+      line = UNLOCK_FAILED;
+    };
+
+    let failure: UnlockFailureKind | null = null;
+    let answer: WaitClaim = { status: "failed" };
+    try {
+      answer = parseWaitClaim(await claimWaitUnlock(chapterId));
+    } catch (error) {
+      failure = claimFailureKind(error);
+    }
+
+    if (failure !== null) {
+      failed(failure);
+    } else if (answer.status === "claimed" || answer.status === "not_locked") {
+      if (answer.status === "claimed") track("wait_unlock_claimed", ids);
+      try {
+        // "Not locked" is a free chapter or one unlocked already, so it also
+        // reads the chapter's own row: the dashboard may have just freed it.
+        const [unlocks, row] = await Promise.all([
+          readBack(),
+          answer.status === "not_locked"
+            ? queryClient.fetchQuery({ ...chapterDetailOptions(chapterId), staleTime: 0 })
+            : Promise.resolve(null),
+        ]);
+        if (unlocks.some((unlock) => unlock.chapter_id === chapterId) || row?.access === "free") {
+          // Read back: M5a's effect opens the chapter, and `opened()` reports it.
+          if (answer.status === "claimed") pending.current = { bookId, chapterId, startedAt };
+          keepSpinning = true;
+        } else {
+          failed("refused");
+        }
+      } catch {
+        failed("network");
+      }
+    } else if (answer.status === "subscribed") {
+      // The server's copy says they have the plan and this phone's doesn't
+      // (yet): ask the server to check with RevenueCat, then read both again.
+      const plan = await syncServerPlan();
+      await Promise.all([
+        queryClient.invalidateQueries({ queryKey: entitlementOptions(userId).queryKey }),
+        queryClient.invalidateQueries({ queryKey: unlocksByUserOptions(userId).queryKey }),
+      ]);
+      line = subscribedLine(plan);
+    } else if (answer.status === "cooldown") {
+      // Claimed elsewhere in the last 24 hours: ask again, and the countdown
+      // shows it. If that read fails too, say so rather than leave the button
+      // as it was, with nothing to tell the reader.
+      const refreshed = await refetchStatus();
+      if (refreshed.isError) line = UNLOCK_FAILED;
+    } else {
+      failed("refused");
+    }
+
+    busy.current = false;
+    if (!mounted.current) return;
+    setClaimLine(line);
+    if (!keepSpinning) setClaiming(false);
+  }, [chapterId, bookId, userId, queryClient, refetchStatus]);
+
+  /** M5a calls it when the chapter opens: reports the unlock the reader just claimed, once. */
+  const opened = useCallback(() => {
+    const claimed = pending.current;
+    if (claimed === null) return;
+    pending.current = null;
+    track("unlock_recorded", {
+      book_id: claimed.bookId,
+      chapter_id: claimed.chapterId,
+      source: "wait",
+      seconds: Math.round((performance.now() - claimed.startedAt) / 1000),
+    });
+  }, []);
+
+  const view = option.kind === "hidden" ? null : waitButtonView(option);
+  return {
+    /** Null where `Unlock free` isn't offered: an open chapter, or a subscriber. */
+    wait:
+      view === null
+        ? null
+        : {
+            label: view.label,
+            accessibilityLabel: claiming ? "Unlock this chapter free. Unlocking." : view.accessibilityLabel,
+            disabled: view.disabled,
+            loading: claiming,
+            // What the claim left, unless the phone is offline: that is what
+            // the reader needs to hear now.
+            line: option.kind === "offline" ? view.line : (claimLine ?? view.line),
+            claim,
+          },
+    opened,
+  };
+}
