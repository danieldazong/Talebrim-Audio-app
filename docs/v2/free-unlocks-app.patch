index 0000000..f69716c
--- /dev/null
+++ b/src/lib/unlock.ts
@@ -0,0 +1,226 @@
+// Free ways to unlock one locked chapter — prompt 23. No React, no hooks, no
+// JSX (AGENTS.md § lib/).
+//
+// Part A, wait-for-free: one free unlock per reader per story every 24 hours,
+// by the server's clock (`claim_wait_unlock()`, `wait_unlock_status()`, the
+// dashboard repo's migration 20261003120000). The app never writes an unlock:
+// the server answers, and only the `unlocks` row read back opens the chapter
+// (AGENTS.md § Billing Rules). Part B's rewarded ad is not built.
+//
+// Everything the server answers is read here as the untrusted data it is.
+
+/** What the server answered to a claim. `failed` is anything we can't read. */
+export type WaitClaim =
+  | { status: "claimed" }
+  | { status: "cooldown"; secondsLeft: number }
+  | { status: "not_locked" }
+  | { status: "subscribed" }
+  | { status: "unavailable" }
+  | { status: "failed" };
+
+/**
+ * Reads `claim_wait_unlock()`'s answer. A status we don't know, a cooldown
+ * without a number of seconds, or anything that isn't the object the server
+ * sends is `failed`: never guessed at.
+ */
+export function parseWaitClaim(value: unknown): WaitClaim {
+  if (typeof value !== "object" || value === null) return { status: "failed" };
+  const { status, seconds_left: secondsLeft } = value as Record<string, unknown>;
+  switch (status) {
+    case "claimed":
+    case "not_locked":
+    case "subscribed":
+    case "unavailable":
+      return { status };
+    case "cooldown":
+      return typeof secondsLeft === "number" && Number.isFinite(secondsLeft) && secondsLeft >= 0
+        ? { status: "cooldown", secondsLeft: Math.ceil(secondsLeft) }
+        : { status: "failed" };
+    default:
+      return { status: "failed" };
+  }
+}
+
+/**
+ * Reads `wait_unlock_status()`'s answer: whole seconds until the next free
+ * unlock, 0 when one is available. Null for anything else.
+ */
+export function parseWaitSeconds(value: unknown): number | null {
+  return typeof value === "number" && Number.isFinite(value) && value >= 0 ? Math.ceil(value) : null;
+}
+
+/**
+ * Why a claim never got an answer: the request didn't get through (`network`),
+ * or the server refused it (`refused`). PostgREST gives every refusal a
+ * `code`; a failed fetch has none.
+ */
+export type ClaimFailureKind = "network" | "refused";
+
+/** What earned an unlock, as analytics names it: the free unlock, or (Part B) a rewarded ad. */
+export type UnlockSource = "wait" | "ad";
+
+/** Why an unlock never reached the reader. `timeout` is Part B's: an ad's unlock that never arrived. */
+export type UnlockFailureKind = ClaimFailureKind | "timeout";
+
+export function claimFailureKind(error: unknown): ClaimFailureKind {
+  const code = typeof error === "object" && error !== null ? (error as { code?: unknown }).code : undefined;
+  return typeof code === "string" && code.length > 0 ? "refused" : "network";
+}
+
+/** Whole minutes and hours, never seconds: "5h 12m", "42m", "1h", "less than a minute". */
+export function formatCountdown(seconds: number): string {
+  const total = Number.isFinite(seconds) ? Math.max(0, Math.floor(seconds)) : 0;
+  if (total < 60) return "less than a minute";
+  const hours = Math.floor(total / 3600);
+  const minutes = Math.floor((total % 3600) / 60);
+  if (hours === 0) return `${minutes}m`;
+  return minutes === 0 ? `${hours}h` : `${hours}h ${minutes}m`;
+}
+
+function unit(count: number, name: string): string {
+  return `${count} ${name}${count === 1 ? "" : "s"}`;
+}
+
+/** `formatCountdown()` as a screen reader should hear it: "5 hours 12 minutes". */
+export function formatCountdownSpoken(seconds: number): string {
+  const total = Number.isFinite(seconds) ? Math.max(0, Math.floor(seconds)) : 0;
+  if (total < 60) return "less than a minute";
+  const hours = Math.floor(total / 3600);
+  const minutes = Math.floor((total % 3600) / 60);
+  return [hours > 0 ? unit(hours, "hour") : null, minutes > 0 ? unit(minutes, "minute") : null]
+    .filter((part) => part !== null)
+    .join(" ");
+}
+
+/**
+ * The seconds still to wait: the server's answer, less the time since it
+ * landed. Both times come from the monotonic clock (`performance.now()`),
+ * never the phone's date, which can be set to anything. Never below 0.
+ */
+export function remainingSeconds(secondsAtAnswer: number, receivedAt: number, now: number): number {
+  return Math.max(0, secondsAtAnswer - Math.max(0, now - receivedAt) / 1000);
+}
+
+/**
+ * How long until the countdown's words next change, so it redraws once a
+ * minute and not every second: at the next whole minute, and in the last
+ * minute, when it ends. At least a second, so a countdown sitting exactly on a
+ * minute can't spin.
+ */
+export function redrawDelayMs(remaining: number): number {
+  const untilChange = remaining < 60 ? remaining : remaining % 60;
+  return Math.max(1_000, untilChange * 1_000) + 50;
+}
+
+/** One reading of the countdown: the seconds left, and when to look again (null once it is over). */
+export type CountdownFrame = { left: number; redrawInMs: number | null };
+
+/**
+ * The countdown at one reading of the clock. The words on screen and the timer
+ * behind them both come from this, with the same three numbers, so they can't
+ * disagree. They did while each read its own clock: the screen's was taken
+ * when the sheet mounted, before the server's answer, so it read the full
+ * answer, and the timer's was fresh and read a few milliseconds less. For an
+ * answer of a whole number of minutes ("1m" exactly) that put the timer a
+ * whole minute out, and the label stayed on "1m" for 60 seconds (found live,
+ * 2026-10-03). A `clock` from before the answer counts no time at all.
+ */
+export function countdownAt(secondsAtAnswer: number, receivedAt: number, clock: number): CountdownFrame {
+  const left = remainingSeconds(secondsAtAnswer, receivedAt, clock);
+  return { left, redrawInMs: left > 0 ? redrawDelayMs(left) : null };
+}
+
+/** The status query as the rule below sees it. */
+export type WaitStatus = { state: "loading" } | { state: "failed" } | { state: "ready"; secondsLeft: number };
+
+export type WaitOption =
+  /** Not offered at all: the chapter is open, or the reader has the plan. */
+  | { kind: "hidden" }
+  | { kind: "loading" }
+  | { kind: "available" }
+  | { kind: "cooldown"; secondsLeft: number }
+  | { kind: "offline" };
+
+type WaitOptionInput = {
+  /** M5a is showing a locked chapter: false for one that is open (free, unlocked or subscribed). */
+  locked: boolean;
+  /** The reader has Talebrim Unlimited. Their plan opens everything, so they never see this. */
+  subscribed: boolean;
+  online: boolean;
+  status: WaitStatus;
+};
+
+/**
+ * Which state M5a's `Unlock free` is in. A running cooldown wins, even
+ * offline: it is the more useful answer. Otherwise nothing can be claimed
+ * offline. A status that couldn't be read leaves the button enabled: the
+ * server decides on the tap, and answers with the cooldown if there is one.
+ */
+export function waitOption({ locked, subscribed, online, status }: WaitOptionInput): WaitOption {
+  if (!locked || subscribed) return { kind: "hidden" };
+  if (status.state === "ready" && status.secondsLeft > 0) return { kind: "cooldown", secondsLeft: status.secondsLeft };
+  if (!online) return { kind: "offline" };
+  if (status.state === "loading") return { kind: "loading" };
+  return { kind: "available" };
+}
+
+export const WAIT_UNLOCK_LABEL = "Unlock free";
+export const WAIT_UNLOCK_RULE = "One free chapter per story every 24 hours.";
+export const WAIT_UNLOCK_OFFLINE = "Connect to the internet to unlock.";
+export const UNLOCK_FAILED = "Couldn't unlock this chapter. Check your connection and try again.";
+export const PLAN_ACTIVE_LINE = "You have an active plan. If this chapter stays locked, tap Restore purchases.";
+export const PLAN_UNCONFIRMED_LINE = "We couldn't confirm your plan just now. Try again.";
+
+/**
+ * What to tell a reader whose claim the server answered "subscribed" when this
+ * phone doesn't (yet) know the plan, once the server has checked it with
+ * RevenueCat (`syncServerPlan()`). Active: their plan is real and this phone
+ * is behind; Restore purchases is the way to catch it up. Otherwise the check
+ * failed or the server's copy was stale: they can simply try again.
+ */
+export function subscribedLine(plan: { active: boolean } | null): string {
+  return plan?.active === true ? PLAN_ACTIVE_LINE : PLAN_UNCONFIRMED_LINE;
+}
+
+export type WaitButtonView = {
+  label: string;
+  /** What the button does and its state, as a screen reader hears it. */
+  accessibilityLabel: string;
+  disabled: boolean;
+  /** Beneath the button: the rule, or why it can't be used. */
+  line: string | null;
+};
+
+/** The words and state of `Unlock free` for each option that shows. */
+export function waitButtonView(option: Exclude<WaitOption, { kind: "hidden" }>): WaitButtonView {
+  switch (option.kind) {
+    case "loading":
+      return {
+        label: WAIT_UNLOCK_LABEL,
+        accessibilityLabel: "Unlock free. Checking whether a free chapter is available.",
+        disabled: true,
+        line: null,
+      };
+    case "available":
+      return {
+        label: WAIT_UNLOCK_LABEL,
+        accessibilityLabel: `Unlock this chapter free. ${WAIT_UNLOCK_RULE}`,
+        disabled: false,
+        line: WAIT_UNLOCK_RULE,
+      };
+    case "cooldown":
+      return {
+        label: `Next free chapter in ${formatCountdown(option.secondsLeft)}`,
+        accessibilityLabel: `Unlock free. Not available: next free chapter in ${formatCountdownSpoken(option.secondsLeft)}.`,
+        disabled: true,
+        line: null,
+      };
+    case "offline":
+      return {
+        label: WAIT_UNLOCK_LABEL,
+        accessibilityLabel: "Unlock free. Not available: connect to the internet to unlock.",
+        disabled: true,
+        line: WAIT_UNLOCK_OFFLINE,
+      };
+  }
+}
