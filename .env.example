# Copy to .env.local and fill in. Only EXPO_PUBLIC_* values belong here:
# that prefix INLINES the value into the JS bundle, so it is public by
# construction. Never add SUPABASE_SERVICE_ROLE_KEY, a RevenueCat secret
# key, or any other secret — AGENTS.md rule 1.

# Supabase — project `story-app-dashboad` (ref fwjrdzzdtshbqrfkgivd).
# The anon key is designed to ship in a client; RLS is what protects data.
EXPO_PUBLIC_SUPABASE_URL=https://fwjrdzzdtshbqrfkgivd.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Clerk — the EXISTING Talebrim application, development instance
# (issuer https://cheerful-walleye-3066.clerk.accounts.dev).
# Never create a second Clerk application — AGENTS.md rule 5.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# PostHog — the Talebrim project (US Cloud, Free plan). The project token
# (phc_...) is a public client key. Explicit events only: prompts/21a.
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Development only: print every PostHog event and send in the Metro terminal.
# EXPO_PUBLIC_POSTHOG_DEBUG=1
