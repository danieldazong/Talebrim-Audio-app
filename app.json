{
  "expo": {
    "name": "talebrim-app",
    "slug": "talebrim-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "talebrimapp",
    "userInterfaceStyle": "dark",
    "android": {
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#150E1F"
        }
      ],
      "@clerk/expo",
      "expo-secure-store",
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true,
          "recordAudioAndroid": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
